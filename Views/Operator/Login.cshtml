@model FoodPreOrder.Models.ViewModels.OperatorLoginViewModel
@{
    Layout = "_LayoutOperator";
    ViewData["Title"] = "เข้าสู่ระบบผู้ประกอบการร้านค้า";
}

<div class="max-w-md mx-auto my-8 bg-white p-6 sm:p-8 rounded-3xl border border-slate-200 shadow-xl">
    <!-- Back to Home Link -->
    <div class="mb-4">
        <a asp-controller="Customer" asp-action="Index" class="inline-flex items-center gap-1.5 text-xs font-medium text-slate-500 hover:text-ocean-600 transition-all">
            <i class="fa-solid fa-arrow-left"></i> กลับสู่หน้าหลัก
        </a>
    </div>

    <div class="text-center mb-6">
        <div class="w-14 h-14 mx-auto rounded-2xl bg-amber-50 text-amber-600 flex items-center justify-center text-2xl mb-3 border border-amber-100 shadow-inner">
            <i class="fa-solid fa-store"></i>
        </div>
        <span class="px-3 py-1 bg-amber-100 text-amber-800 text-xs font-bold rounded-full">ส่วนของผู้ประกอบการ (Operator)</span>
        <h2 class="text-2xl font-extrabold text-slate-800 mt-2">เข้าสู่ระบบจัดการร้านค้า</h2>
        <p class="text-xs text-slate-500 mt-1">จัดการออเดอร์ที่เข้ามาและบริหารรายการเมนูอาหาร</p>
    </div>

    <form asp-action="Login" method="post" class="space-y-4">
        @Html.AntiForgeryToken()
        <div asp-validation-summary="ModelOnly" class="text-rose-600 text-xs bg-rose-50 p-3 rounded-xl"></div>

        <div>
            <label asp-for="Email" class="block text-xs font-medium text-slate-700 mb-1">อีเมลร้านค้า</label>
            <input asp-for="Email" id="input-op-email" class="w-full px-4 py-2.5 rounded-xl border border-slate-200 text-sm focus:ring-2 focus:ring-ocean-500 focus:outline-none" placeholder="operator@demo.com" />
            <span asp-validation-for="Email" class="text-rose-500 text-xs"></span>
        </div>

        <div>
            <label asp-for="Password" class="block text-xs font-medium text-slate-700 mb-1">รหัสผ่าน</label>
            <input asp-for="Password" id="input-op-pass" class="w-full px-4 py-2.5 rounded-xl border border-slate-200 text-sm focus:ring-2 focus:ring-ocean-500 focus:outline-none" placeholder="••••••••" />
            <span asp-validation-for="Password" class="text-rose-500 text-xs"></span>
        </div>

        <button type="submit" class="w-full py-3 bg-ocean-600 hover:bg-ocean-700 text-white font-bold rounded-xl text-sm shadow-md shadow-ocean-200 transition-all flex items-center justify-center gap-2">
            <i class="fa-solid fa-right-to-bracket"></i> เข้าสู่ระบบจัดการร้าน
        </button>
    </form>

    <div class="mt-6 pt-4 border-t border-slate-100 flex flex-col sm:flex-row justify-between items-center gap-2">
        <a asp-controller="Customer" asp-action="Index" class="text-xs font-bold text-ocean-600 hover:underline flex items-center gap-1.5">
            <i class="fa-solid fa-house"></i> กลับสู่หน้าหลัก
        </a>
        <div class="text-xs">
            <span class="text-slate-500">ต้องการเปิดร้านค้า?</span>
            <a asp-action="Register" class="font-bold text-amber-600 hover:underline ml-1">ลงทะเบียนร้านค้าใหม่</a>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
