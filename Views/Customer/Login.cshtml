@model FoodPreOrder.Models.ViewModels.CustomerLoginViewModel
@{
    Layout = "_LayoutCustomer";
    ViewData["Title"] = "เข้าสู่ระบบลูกค้า";
}

<div class="max-w-md mx-auto my-8 bg-white p-6 sm:p-8 rounded-3xl border border-slate-200 shadow-xl">
    <!-- Header -->
    <div class="text-center mb-6">
        <div class="w-14 h-14 mx-auto rounded-2xl bg-ocean-50 text-ocean-600 flex items-center justify-center text-2xl mb-3 border border-ocean-100 shadow-inner">
            <i class="fa-solid fa-user"></i>
        </div>
        <span class="px-3 py-1 bg-ocean-100 text-ocean-700 text-xs font-bold rounded-full">ส่วนของลูกค้า (Customer Only)</span>
        <h2 class="text-2xl font-extrabold text-slate-800 mt-2">เข้าสู่ระบบสั่งอาหาร</h2>
        <p class="text-xs text-slate-500 mt-1">เข้าสู่ระบบเพื่อเพิ่มอาหารลงตะกร้าและสั่งจองล่วงหน้า</p>
    </div>

    <form asp-action="Login" method="post" class="space-y-4">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="ReturnUrl" />
        <div asp-validation-summary="ModelOnly" class="text-rose-600 text-xs bg-rose-50 p-3 rounded-xl"></div>

        <div>
            <label asp-for="Email" class="block text-xs font-medium text-slate-700 mb-1">อีเมลผู้ใช้งาน</label>
            <input asp-for="Email" id="input-email" class="w-full px-4 py-2.5 rounded-xl border border-slate-200 text-sm focus:ring-2 focus:ring-ocean-500 focus:outline-none" placeholder="name@example.com" />
            <span asp-validation-for="Email" class="text-rose-500 text-xs"></span>
        </div>

        <div>
            <label asp-for="Password" class="block text-xs font-medium text-slate-700 mb-1">รหัสผ่าน</label>
            <input asp-for="Password" id="input-password" class="w-full px-4 py-2.5 rounded-xl border border-slate-200 text-sm focus:ring-2 focus:ring-ocean-500 focus:outline-none" placeholder="••••••••" />
            <span asp-validation-for="Password" class="text-rose-500 text-xs"></span>
        </div>

        <button type="submit" class="w-full py-3 bg-ocean-600 hover:bg-ocean-700 text-white font-bold rounded-xl text-sm shadow-md shadow-ocean-200 transition-all flex items-center justify-center gap-2">
            <i class="fa-solid fa-right-to-bracket"></i> เข้าสู่ระบบ
        </button>
    </form>

    <div class="mt-6 pt-4 border-t border-slate-100 text-center">
        <span class="text-xs text-slate-500">ยังไม่มีบัญชีลูกค้า?</span>
        <a asp-action="Register" class="text-xs font-bold text-ocean-600 hover:underline ml-1">สมัครสมาชิกใหม่ที่นี่</a>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
