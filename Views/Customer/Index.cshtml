@model List<FoodPreOrder.Models.Domain.FoodItem>
@{
    Layout = "_LayoutCustomer";
    ViewData["Title"] = "หน้าแรก - สั่งอาหารล่วงหน้า";
    var selectedCat = ViewBag.SelectedCategory as string ?? "ทั้งหมด";
    var searchQuery = ViewBag.SearchQuery as string ?? "";
    var categories = new[] { "ทั้งหมด", "อาหารจานเดียว", "เครื่องดื่ม", "เบเกอรี่", "ทานเล่น" };
}

<div class="space-y-6">
    <!-- Hero Banner (Page 1) -->
    <div class="relative bg-gradient-to-r from-ocean-700 via-ocean-600 to-ocean-800 rounded-3xl p-6 sm:p-10 text-white overflow-hidden shadow-xl shadow-ocean-100">
        <div class="absolute -right-10 -bottom-10 opacity-10 text-white">
            <i class="fa-solid fa-bowl-food text-[240px]"></i>
        </div>
        <div class="relative z-10 max-w-2xl space-y-3">
            <span class="inline-block px-3 py-1 bg-white/20 backdrop-blur-md text-xs font-semibold rounded-full uppercase tracking-wider text-ocean-100">
                <i class="fa-solid fa-bolt mr-1 text-amber-300"></i>สั่งล่วงหน้า ไม่ต้องรอคิว
            </span>
            <h1 class="text-2xl sm:text-4xl font-extrabold leading-tight">
                อิ่มอร่อยตรงเวลา ชำระเงินสดหน้าร้านสะดวกยิ่งขึ้น
            </h1>
            <p class="text-ocean-100 text-sm sm:text-base font-light">
                เลือกร้านโปรด ระบุเวลาสั่งจองล่วงหน้า แล้วรับอาหารได้ทันทีโดยไม่ต้องรอนาน!
            </p>
        </div>
    </div>

    <!-- Search and Filter Bar -->
    <div class="flex flex-col md:flex-row gap-4 justify-between items-center bg-white p-4 rounded-2xl border border-slate-200 shadow-sm">
        <!-- Search Input -->
        <form method="get" asp-action="Index" class="relative w-full md:w-96 flex">
            <input type="hidden" name="category" value="@selectedCat" />
            <i class="fa-solid fa-magnifying-glass absolute left-4 top-1/2 -translate-y-1/2 text-slate-400"></i>
            <input type="text" name="search" value="@searchQuery" placeholder="ค้นหาเมนูอาหาร หรือ ชื่อร้านค้า..." class="w-full pl-11 pr-20 py-2.5 bg-slate-50 border border-slate-200 rounded-xl text-sm focus:outline-none focus:ring-2 focus:ring-ocean-500 focus:bg-white transition-all">
            <button type="submit" class="absolute right-2 top-1/2 -translate-y-1/2 px-3 py-1 bg-ocean-600 text-white rounded-lg text-xs font-medium hover:bg-ocean-700">ค้นหา</button>
        </form>

        <!-- Category Pills Filter -->
        <div class="flex items-center gap-2 overflow-x-auto w-full md:w-auto pb-2 md:pb-0 custom-scrollbar">
            @foreach (var cat in categories)
            {
                var isActive = selectedCat == cat;
                <a asp-action="Index" asp-route-category="@cat" asp-route-search="@searchQuery" class="px-3.5 py-1.5 rounded-xl text-xs whitespace-nowrap transition-all @(isActive ? "bg-ocean-600 text-white font-bold shadow-md shadow-ocean-200" : "bg-slate-100 text-slate-600 hover:bg-slate-200 font-medium")">
                    @cat
                </a>
            }
        </div>
    </div>

    <!-- Guest Notice Banner (Page 1) -->
    <div class="bg-amber-50 border-l-4 border-amber-400 p-4 rounded-r-xl flex items-start gap-3">
        <i class="fa-solid fa-circle-info text-amber-500 text-lg mt-0.5"></i>
        <div class="text-xs sm:text-sm text-amber-800">
            <span class="font-bold">หมายเหตุสำคัญ:</span> ท่านสามารถดูรายการอาหารได้โดยไม่ต้องเข้าสู่ระบบ แต่หากต้องการ <span class="font-semibold underline">เพิ่มลงตะกร้า</span> หรือ <span class="font-semibold underline">สั่งซื้อ</span> ระบบจะขอให้ท่านเข้าสู่ระบบหรือสมัครสมาชิกก่อนเสมอ
        </div>
    </div>

    <!-- Food Menu Grid Section -->
    <div>
        <div class="flex items-center justify-between mb-4">
            <h2 class="text-xl font-bold text-slate-800 flex items-center gap-2">
                <i class="fa-solid fa-fire text-rose-500"></i> เมนูอาหารแนะนำ
            </h2>
            <span class="text-xs font-medium text-slate-500">กำลังแสดง @Model.Count เมนู</span>
        </div>
        
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-6">
            @if (Model.Count == 0)
            {
                <div class="col-span-full text-center py-12 bg-white rounded-2xl border border-slate-200">
                    <i class="fa-solid fa-utensils text-4xl text-slate-300 mb-2"></i>
                    <p class="text-slate-500 font-medium">ไม่พบเมนูอาหารที่ตรงกับเงื่อนไขค้นหา</p>
                </div>
            }
            else
            {
                @foreach (var item in Model)
                {
                    <div class="bg-white rounded-2xl border border-slate-200 shadow-sm hover:shadow-lg transition-all overflow-hidden flex flex-col justify-between group">
                        <div>
                            <div class="relative h-44 overflow-hidden bg-slate-100">
                                <img src="@item.ImageUrl" alt="@item.Name" class="w-full h-full object-cover group-hover:scale-105 transition-all duration-300" onerror="this.src='https://placehold.co/400x300/2563eb/ffffff?text=FoodPreOrder'">
                                <span class="absolute top-3 left-3 bg-white/90 backdrop-blur-md text-ocean-700 text-[10px] font-bold px-2.5 py-1 rounded-full shadow-sm">
                                    @item.Category
                                </span>
                                <span class="absolute bottom-3 right-3 bg-slate-900/80 text-white text-[10px] font-medium px-2 py-0.5 rounded-md backdrop-blur-sm">
                                    <i class="fa-regular fa-clock text-amber-400 mr-1"></i>~@item.PrepTimeMinutes นาที
                                </span>
                            </div>
                            <div class="p-4 space-y-1">
                                <div class="text-[11px] font-semibold text-ocean-600">@item.ShopName</div>
                                <h3 class="font-bold text-slate-800 text-base line-clamp-1">@item.Name</h3>
                            </div>
                        </div>
                        <div class="p-4 pt-0 flex justify-between items-center border-t border-slate-50 mt-2">
                            <div>
                                <span class="text-xs text-slate-400">ราคา</span>
                                <div class="text-lg font-extrabold text-slate-800">฿@item.Price.ToString("N0")</div>
                            </div>
                            <button type="button" onclick="addToCart('@item.Id')" class="px-3.5 py-2 bg-ocean-600 hover:bg-ocean-700 text-white font-medium rounded-xl text-xs shadow-md shadow-ocean-200 transition-all flex items-center gap-1.5">
                                <i class="fa-solid fa-cart-plus"></i>เพิ่มลงตะกร้า
                            </button>
                        </div>
                    </div>
                }
            }
        </div>
    </div>
</div>
