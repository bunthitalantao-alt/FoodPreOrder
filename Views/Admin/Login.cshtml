@model FoodPreOrder.Models.ViewModels.AdminLoginViewModel
@{
    Layout = "_LayoutAdmin";
    ViewData["Title"] = "เข้าสู่ระบบผู้ดูแลระบบ";
}

<div class="max-w-md mx-auto my-8 bg-white p-6 sm:p-8 rounded-3xl border border-slate-200 shadow-xl">
    <div class="text-center mb-6">
        <div class="w-14 h-14 mx-auto rounded-2xl bg-purple-50 text-purple-700 flex items-center justify-center text-2xl mb-3 border border-purple-100 shadow-inner">
            <i class="fa-solid fa-user-shield"></i>
        </div>
        <span class="px-3 py-1 bg-purple-100 text-purple-700 text-xs font-bold rounded-full">ส่วนของผู้ดูแลระบบ (Backend Admin)</span>
        <h2 class="text-2xl font-extrabold text-slate-800 mt-2">เข้าสู่ระบบแอดมิน</h2>
        <p class="text-xs text-slate-500 mt-1">แผงควบคุมระบบภาพรวม FoodPreOrder และอนุมัติร้านค้า</p>
    </div>

    <form asp-action="Login" method="post" class="space-y-4">
        @Html.AntiForgeryToken()
        <div asp-validation-summary="ModelOnly" class="text-rose-600 text-xs bg-rose-50 p-3 rounded-xl"></div>

        <div>
            <label asp-for="Email" class="block text-xs font-medium text-slate-700 mb-1">อีเมลผู้ดูแลระบบ</label>
            <input asp-for="Email" id="input-admin-email" class="w-full px-4 py-2.5 rounded-xl border border-slate-200 text-sm focus:ring-2 focus:ring-purple-500 focus:outline-none" placeholder="admin@domain.com" />
            <span asp-validation-for="Email" class="text-rose-500 text-xs"></span>
        </div>

        <div>
            <label asp-for="Password" class="block text-xs font-medium text-slate-700 mb-1">รหัสผ่าน</label>
            <input asp-for="Password" id="input-admin-pass" class="w-full px-4 py-2.5 rounded-xl border border-slate-200 text-sm focus:ring-2 focus:ring-purple-500 focus:outline-none" placeholder="••••••••" />
            <span asp-validation-for="Password" class="text-rose-500 text-xs"></span>
        </div>

        <button type="submit" class="w-full py-3 bg-purple-700 hover:bg-purple-800 text-white font-bold rounded-xl text-sm shadow-md shadow-purple-200 transition-all flex items-center justify-center gap-2">
            <i class="fa-solid fa-lock-open"></i> เข้าสู่ระบบแอดมิน
        </button>
    </form>

    <div class="mt-6 pt-4 border-t border-slate-100 text-center">
        <a asp-controller="Customer" asp-action="Index" class="text-xs font-semibold text-purple-700 hover:underline inline-flex items-center gap-1.5">
            <i class="fa-solid fa-house"></i> กลับสู่หน้าหลัก (ลูกค้า)
        </a>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
