<!DOCTYPE html>
<html lang="th" class="h-full bg-slate-50">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewData["Title"] - ผู้ประกอบการ (FoodPreOrder Operator)</title>
    <!-- Tailwind CSS CDN -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- FontAwesome 6 Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <!-- Chart.js CDN -->
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <!-- Google Fonts: Kanit -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Kanit:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        ocean: {
                            50: '#eff6ff',
                            100: '#dbeafe',
                            200: '#bfdbfe',
                            300: '#93c5fd',
                            400: '#60a5fa',
                            500: '#3b82f6',
                            600: '#2563eb',
                            700: '#1d4ed8',
                            800: '#1e40af',
                            900: '#1e3a8a',
                        }
                    },
                    fontFamily: {
                        sans: ['Kanit', 'sans-serif'],
                    }
                }
            }
        }
    </script>
    <style>
        body { font-family: 'Kanit', sans-serif; }
        .custom-scrollbar::-webkit-scrollbar { width: 6px; }
        .custom-scrollbar::-webkit-scrollbar-track { background: #f1f5f9; }
        .custom-scrollbar::-webkit-scrollbar-thumb { background: #cbd5e1; border-radius: 4px; }
        .custom-scrollbar::-webkit-scrollbar-thumb:hover { background: #94a3b8; }
    </style>
</head>
<body class="h-full text-slate-800 flex flex-col min-h-screen">

    <!-- Top Header for Operator (Page 5: - มีแค่ หน้า จัดการร้านค้า) -->
    <header class="bg-white border-b border-slate-200 sticky top-0 z-40 shadow-sm">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="flex justify-between items-center h-16">
                
                <!-- Logo -->
                <a asp-controller="@(ViewBag.CurrentOperator != null ? "Operator" : "Customer")" asp-action="@(ViewBag.CurrentOperator != null ? "Dashboard" : "Index")" class="flex items-center space-x-3" title="คลิกเพื่อกลับหน้าหลัก">
                    <div class="w-10 h-10 rounded-xl bg-gradient-to-tr from-ocean-600 to-ocean-400 flex items-center justify-center text-white shadow-md shadow-ocean-200">
                        <i class="fa-solid fa-shop text-xl"></i>
                    </div>
                    <div>
                        <span class="text-xl font-bold bg-gradient-to-r from-ocean-700 to-ocean-500 bg-clip-text text-transparent">FoodPreOrder</span>
                        <span class="block text-[10px] text-ocean-600 font-semibold tracking-wider uppercase -mt-1">Operator Portal</span>
                    </div>
                </a>

                <!-- Central Navigation: ONLY "จัดการร้านค้า" as specified in PDF Page 5 -->
                <nav class="flex space-x-2">
                    <a asp-controller="Operator" asp-action="Dashboard" class="px-4 py-2 rounded-lg text-sm font-bold text-ocean-600 bg-ocean-50">
                        <i class="fa-solid fa-store mr-1.5"></i>จัดการร้านค้า
                    </a>
                </nav>

                <!-- Right Actions: Operator Info or Return to Home Link -->
                <div class="flex items-center space-x-3">
                    @if (ViewBag.CurrentOperator != null)
                    {
                        var op = (FoodPreOrder.Models.Domain.UserAccount)ViewBag.CurrentOperator;
                        <div class="text-right hidden sm:block">
                            <div class="font-bold text-xs text-slate-800">@(op.ShopName ?? op.FullName)</div>
                            <span class="text-[10px] px-2 py-0.5 bg-amber-100 text-amber-800 font-semibold rounded-full">ผู้ประกอบการ</span>
                        </div>
                        <form asp-controller="Operator" asp-action="Logout" method="post" class="inline">
                            <button type="submit" class="p-2 text-slate-400 hover:text-rose-600 rounded-xl hover:bg-rose-50 transition-all" title="ออกจากระบบร้านค้า">
                                <i class="fa-solid fa-arrow-right-from-bracket text-lg"></i>
                            </button>
                        </form>
                    }
                    else
                    {
                        <a asp-controller="Customer" asp-action="Index" class="px-3.5 py-2 text-xs font-semibold text-ocean-600 hover:text-ocean-700 bg-ocean-50 hover:bg-ocean-100 rounded-xl transition-all flex items-center gap-1.5 border border-ocean-200 shadow-sm" title="กลับสู่หน้าหลัก">
                            <i class="fa-solid fa-house"></i> กลับสู่หน้าหลัก
                        </a>
                    }
                </div>
            </div>
        </div>
    </header>

    <!-- Notification Toast Banners -->
    <div id="toast-container" class="fixed top-20 right-4 z-50 flex flex-col gap-2 max-w-sm w-full pointer-events-none">
        @if (TempData["SuccessMessage"] != null)
        {
            <div class="bg-emerald-600 text-white px-4 py-3 rounded-2xl shadow-xl flex items-center gap-3 text-sm pointer-events-auto">
                <i class="fa-solid fa-circle-check text-lg"></i>
                <span>@TempData["SuccessMessage"]</span>
            </div>
        }
        @if (TempData["ErrorMessage"] != null)
        {
            <div class="bg-rose-600 text-white px-4 py-3 rounded-2xl shadow-xl flex items-center gap-3 text-sm pointer-events-auto">
                <i class="fa-solid fa-circle-exclamation text-lg"></i>
                <span>@TempData["ErrorMessage"]</span>
            </div>
        }
    </div>

    <!-- MAIN BODY CONTENT -->
    <main class="flex-grow max-w-7xl w-full mx-auto px-4 sm:px-6 lg:px-8 py-6">
        @RenderBody()
    </main>

    <!-- Footer -->
    <footer class="bg-white border-t border-slate-200 mt-12 py-4 text-xs text-slate-400 text-center">
        ระบบจัดการร้านค้า FoodPreOrder Operator Console - ชำระเงินสดหน้าร้าน
    </footer>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
